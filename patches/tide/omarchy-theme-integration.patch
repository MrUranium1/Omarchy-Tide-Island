+            themeApplyProcess.running = false;
+        themeApplyProcess.themeName = slug;
+        themeApplyProcess.running = true;
+    }
+
+    function handleThemeApplied(slug, ok) {
+        if (ok) {
+            omarchyThemeSlug = slug;
+            wallpapersLoaded = false;
+            resetThemes();
